{
	"name": "likh",
	"description": "Offline-first journaling that saves to your own GitHub repo, one markdown file per day.",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:tz": "for tz in Pacific/Kiritimati Pacific/Niue America/Santiago Asia/Kolkata UTC; do echo \"== $tz\" && TZ=$tz vitest run || exit 1; done",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"deploy": "pnpm build && wrangler deploy",
		"cf:preview": "pnpm build && wrangler dev",
		"cf:typegen": "wrangler types ./src/worker-configuration.d.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260828.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.9.1",
		"fake-indexeddb": "^6.2.5",
		"fast-check": "^4.9.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.11",
		"wrangler": "^4.127.0"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.0",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.9",
		"@lezer/highlight": "^1.2.3",
		"@lezer/markdown": "^1.7.2",
		"idb": "^8.0.3",
		"minisearch": "^7.2.0",
		"node-diff3": "^3.2.1"
	}
}
