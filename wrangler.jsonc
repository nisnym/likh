{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "likh",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-28",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
		// Non-matching navigations fall through to the SPA shell so client-side
		// routing (and the offline service worker) own the URL space.
		"not_found_handling": "single-page-application",
		// ...but the Worker must win for the BFF endpoints, otherwise these
		// would be swallowed by the SPA fallback above.
		"run_worker_first": ["/api/*", "/auth/*"]
	},
	// OAuth transactions and sessions. The id below is likh.dev's own namespace.
	// Deploying your own copy? Make yours and swap it in:
	//   wrangler kv namespace create SESSIONS
	// Local `vite dev` and `wrangler dev` simulate this namespace, so any id
	// works for development.
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "ff5a6465798b4ce7a6aa81603b5e1ecb"
		}
	],
	// Public values. The client secret is not here — set it with
	//   wrangler secret put GITHUB_CLIENT_SECRET
	// and put it in .dev.vars for local development.
	"vars": {
		"GITHUB_CLIENT_ID": "",
		"GITHUB_APP_SLUG": ""
	},
	"observability": {
		"enabled": true
	}
}
